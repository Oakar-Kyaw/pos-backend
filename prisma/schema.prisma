generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Gender {
  MALE
  FEMALE
}

enum VoucherType {
  SAVE
  DRAFT
}

enum PaymentType {
  CASH
  BANK
  CARD
  EWALLET
}

enum AccountType {
  CASH
  BANK
  CARD
  EWALLET
}

enum Role {
  CUSTOMER
  SALE
  POS
  ADMIN
  SUPERADMIN
}

//////////////////////////////////////////////////////
// COMPANY
//////////////////////////////////////////////////////

model Company {
  id       Int     @id @default(autoincrement())
  code     String?
  email    String  @unique
  name     String  @unique
  phone    String?
  address  String?
  photoUrl String?

  products                Product[]
  vouchers                Voucher[]
  branches                Branch[]
  currencies              Currency[]
  userCompanyRelationship UserCompanyRelationship[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

//////////////////////////////////////////////////////
// BRANCH
//////////////////////////////////////////////////////

model Branch {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String
  address   String?
  latitude  String?
  longitude String?
  isDeleted Boolean @default(false)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  users    User[]    @relation("UserBranch")
  vouchers Voucher[] @relation("VoucherBranch")

  @@index([companyId])
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  role  Role   @default(CUSTOMER)

  firstName String?
  lastName  String?
  password  String?
  phone     String?
  photoUrl  String?

  gender    Gender  @default(MALE)
  isDeleted Boolean @default(false)

  branchId Int?
  branch   Branch? @relation("UserBranch", fields: [branchId], references: [id])

  vouchers                Voucher[]
  categories              Category[]
  products                Product[]
  userCompanyRelationship UserCompanyRelationship[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dateOfBirth DateTime?

  @@index([branchId])
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id        Int     @id @default(autoincrement())
  title     String
  isDeleted Boolean @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  products Product[]

  @@index([userId])
}

//////////////////////////////////////////////////////
// PRODUCT
//////////////////////////////////////////////////////

model Product {
  id Int @id @default(autoincrement())

  name        String
  code        String  @unique
  barcode     String?
  description String?
  photoUrl    String?

  price     Decimal  @db.Decimal(12, 2)
  costPrice Decimal? @db.Decimal(12, 2)

  stock    Int  @default(0)
  minStock Int?

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([categoryId])
  @@index([name])
}

//////////////////////////////////////////////////////
// VOUCHER
//////////////////////////////////////////////////////

model Voucher {
  id          Int    @id @default(autoincrement())
  voucherCode String @unique

  type VoucherType @default(DRAFT)

  subTotal    Decimal @default(0.00) @db.Decimal(12, 2)
  tax         Decimal @default(0.00) @db.Decimal(12, 2)
  deliveryFee Decimal @default(0.00) @db.Decimal(12, 2)

  totalPaymentAmount     Decimal @default(0.00) @db.Decimal(12, 2)
  remainingPaymentAmount Decimal @default(0.00) @db.Decimal(12, 2)

  total Decimal @default(0.00) @db.Decimal(12, 2)

  note      String?
  isDeleted Boolean @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId Int?
  branch   Branch? @relation("VoucherBranch", fields: [branchId], references: [id])

  items         VoucherItem[]
  payments      Payment[]
  paymentPhotos PaymentPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// VOUCHER ITEM
//////////////////////////////////////////////////////

model VoucherItem {
  id Int @id @default(autoincrement())

  voucherId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  itemId   Int
  name     String
  photoUrl String?

  quantity Int     @default(0)
  price    Decimal @default(0.00) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([voucherId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {
  id Int @id @default(autoincrement())

  voucherId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  paymentDataId Int
  paymentData   PaymentData @relation(fields: [paymentDataId], references: [id])

  amount Decimal     @db.Decimal(12, 2)
  type   PaymentType @default(CASH)

  createdAt DateTime @default(now())

  @@index([voucherId])
}

//////////////////////////////////////////////////////
// PAYMENT PHOTO
//////////////////////////////////////////////////////

model PaymentPhoto {
  id Int @id @default(autoincrement())

  voucherId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  photoUrl String

  createdAt DateTime @default(now())

  @@index([voucherId])
}

//////////////////////////////////////////////////////
// PAYMENT DATA (Accounts)
//////////////////////////////////////////////////////

model PaymentData {
  id Int @id @default(autoincrement())

  name          String
  accountNumber String?
  accountName   String
  accountType   AccountType

  companyId Int
  userId    Int

  isActive Boolean @default(true)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

//////////////////////////////////////////////////////
// CURRENCY
//////////////////////////////////////////////////////

model Currency {
  id             Int     @id @default(autoincrement())
  currencyCode   String  @unique
  value          Int     @default(1)
  setDefault     Boolean @default(false)
  currencySymbol String

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

//////////////////////////////////////////////////////
// USER COMPANY RELATION
//////////////////////////////////////////////////////

model UserCompanyRelationship {
  id Int @id @default(autoincrement())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
}
