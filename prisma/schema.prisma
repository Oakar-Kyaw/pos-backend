// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  role      Role     @default(CUSTOMER)

  firstName String?
  lastName  String?
  password  String?
  phone     String?
  photoUrl  String?

  gender    Gender   @default(MALE)
  isDeleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dateOfBirth DateTime?
  categories Category[]    @relation("categories")
  products   Product[]     @relation("product")
  userCompanyRelationship UserCompanyRelationship[]
  vouchers   Voucher[]
}

model Company {
  id      Int    @id @default(autoincrement())
  code    String?
  email   String @unique
  name    String @unique
  phone   String?
  address String?

  products Product[]      @relation("productByCompany")
  userCompanyRelationship UserCompanyRelationship[]
  currencies  Currency[]  @relation("companycurrency") 
  vouchers   Voucher[]
}

model Category {
  id        Int      @id @default(autoincrement())
  title     String
  isDeleted Boolean  @default(false)

  userId    Int
  user      User     @relation("categories", fields: [userId], references: [id], onDelete: Cascade)

  products  Product[] @relation("productByCategories")
}

model Product {
  id          Int      @id @default(autoincrement())

  name        String
  code        String   @unique
  barcode     String? 
  description String?
  photoUrl    String?

  price       Decimal  @db.Decimal(10,2)
  costPrice   Decimal? @db.Decimal(10,2)

  stock       Int      @default(0)
  minStock    Int?

  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)

  categoryId  Int
  category    Category @relation("productByCategories",fields: [categoryId], references: [id])

  userId      Int
  user        User     @relation("product",fields: [userId], references: [id])

  companyId   Int
  company     Company  @relation("productByCompany", fields: [companyId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Voucher {
  id        Int      @id @default(autoincrement())
  voucherCode String @unique
  type      VoucherType @default(DRAFT)
  subTotal  Float    @default(0)
  tax       Float    @default(0)
  total     Float    @default(0)
  note      String?
  isDeleted Boolean  @default(false)

  items     VoucherItem[]  

  payments   Payment[]

  userId    Int 
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId    Int 
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VoucherItem {
  id         Int     @id @default(autoincrement())

  voucher    Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  voucherId  Int

  itemId     Int
  name       String
  photoUrl   String?
  quantity   Int     @default(0)
  price      Float   @default(0)

  createdAt  DateTime @default(now())
}

model Payment {
  id         Int         @id @default(autoincrement())

  voucher    Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  voucherId  Int

  paymentData   PaymentData @relation(fields: [paymentDataId], references: [id])
  paymentDataId Int

  amount     Float

  createdAt  DateTime    @default(now())
}

model PaymentData {
  id            Int         @id @default(autoincrement())

  name          String      // Account display name (ABA Bank, Visa Card, Cash Drawer)
  accountNumber String?
  accountName   String
  accountType   AccountType

  companyId     Int
  userId        Int

  isActive      Boolean     @default(true)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  payments      Payment[]   // relation (optional)
}


model Currency {
  id              Int      @id @default(autoincrement())
  currencyCode    String   @unique
  value           Int      @default(1)
  setDefault      Boolean  @default(false)
  currencySymbol  String 
  companyId       Int
  company         Company  @relation("companycurrency", fields:[companyId], references: [id])         
}

model DeviceInfo {
  id          Int      @id @default(autoincrement())
  deviceToken String   @unique
  deviceType  String?
  deviceName  String?
  ipAddress   String?
  lastActive  DateTime @default(now())
}

model UserCompanyRelationship {
  id                      Int                   @id @default(autoincrement())
  companyId               Int 
  company                 Company               @relation(fields:[companyId], references: [id])
  userId                  Int 
  user                    User                  @relation(fields:[userId], references: [id])
}

enum Gender {
  MALE
  FEMALE
}

enum VoucherType {
  SAVE
  DRAFT
}

enum PaymentType {
  CASH
  BANK
  CARD
  EWALLET
}

enum AccountType {
  CASH
  BANK
  CARD
  EWALLET
}

enum Role {
  CUSTOMER
  SALE
  POS
  ADMIN
  SUPERADMIN
}