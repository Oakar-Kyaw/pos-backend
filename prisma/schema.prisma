generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum Gender {
  MALE
  FEMALE
}

enum VoucherType {
  SAVE
  DRAFT
}

enum PaymentType {
  CASH
  BANK
  CARD
  EWALLET
}

enum AccountType {
  CASH
  BANK
  CARD
  EWALLET
}

enum RefundType {
  FULL
  PARTIAL
}

enum InventoryType {
  EXPIRED
  DAMAGED
  REQUESTED
}

enum Role {
  CUSTOMER
  SALE
  POS
  ADMIN
  MANAGER
  SUPERADMIN
}

enum EmployeeType {
  MONTHLY
  HOURLY
}

enum TransactionType {
  OPENING_BALANCE
  CLOSING_BALANCE
}

model SaleReport {
  id            Int    @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  date          DateTime
  type          TransactionType // e.g., 'OPENING_BALANCE', 'SALE', 'REFUND', 'CLOSING_BALANCE', 'EXPENSE'
  amount        Decimal     @db.Decimal(12, 2) // The value of the transaction
  description   String?   // Optional: details like product name, reason for expense
  saleId        Int
  saleUser      User     @relation("saleuserfromsalereport", fields: [saleId], references: [id])
  isClosed      Boolean   @default(false)          

  companyId     Int
  company       Company     @relation("companyfromsalereport", fields: [companyId], references: [id])

  branchId      Int?
  branch        Branch?     @relation("branchfromsalereport", fields: [branchId], references: [id])

  isDeleted     Boolean     @default(false)
}

model Transfer {
  id            Int    @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  date          DateTime
  amount        Decimal     @db.Decimal(12, 2) 

  from          Int
  fromAccount   PaymentData @relation("fromAccount",fields: [from], references: [id])

  to            Int
  toAccount     PaymentData @relation("toAccount", fields: [to], references: [id])

  saleId        Int
  saleUser      User     @relation("saleuserfromtransfer", fields: [saleId], references: [id])

  companyId     Int
  company       Company     @relation("companyfromtransfer", fields: [companyId], references: [id])

  branchId      Int?
  branch        Branch?     @relation("branchfromtransfer", fields: [branchId], references: [id])


  isDeleted     Boolean     @default(false)
}

model GeneralExpense {
  id        Int      @id @default(autoincrement())

  title     String
  reason    String?
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime

  // 🔗 Company Relation
  company   Company  @relation("companyFromGeneralExpense", fields: [companyId], references: [id])
  companyId Int

  // 🔗 Branch Relation (Optional)
  branch    Branch?  @relation("branchFromGeneralExpense", fields: [branchId], references: [id])
  branchId  Int?

  // 🔗 User Relation
  user      User     @relation("userFromGeneralExpense", fields: [userId], references: [id])
  userId    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([companyId])
  @@index([branchId])
  @@index([userId])
  @@index([date])
}

//////////////////////////////////////////////////////
// COMPANY
//////////////////////////////////////////////////////

model Company {
  id       Int     @id @default(autoincrement())
  code     String?
  email    String  @unique
  name     String  @unique
  phone    String?
  address  String?
  photoUrl String?
  lat      String?
  long     String?

  products           Product[]
  vouchers           Voucher[]
  branches           Branch[]
  currencies         Currency[]
  userCompanyRelationship UserCompanyRelationship[]
  saleReports        SaleReport[] @relation("companyfromsalereport")
  transfers          Transfer[]   @relation("companyfromtransfer")
  generalExpenses    GeneralExpense[] @relation("companyFromGeneralExpense")
  refunds            Refund[]
  inventories        InventoryManagement[]
  repay              Repay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

//////////////////////////////////////////////////////
// BRANCH
//////////////////////////////////////////////////////

model Branch {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String
  address   String?
  latitude  String?
  longitude String?
  isDeleted Boolean @default(false)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  saleReports        SaleReport[] @relation("branchfromsalereport")
  transfers          Transfer[]   @relation("branchfromtransfer")

  generalExpenses GeneralExpense[] @relation("branchFromGeneralExpense")
  refunds         Refund[]
  inventories     InventoryManagement[]
  repay   Repay[]

  users    User[]    @relation("UserBranch")
  vouchers Voucher[] @relation("VoucherBranch")

  @@index([companyId])
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  role  Role   @default(CUSTOMER)
  employeeType EmployeeType? @default(MONTHLY)

  firstName String?
  lastName  String?
  password  String?
  phone     String?
  photoUrl  String?

  gender    Gender  @default(MALE)
  isDeleted Boolean @default(false)

  salary    Int?
  hourlyRate Decimal? @db.Decimal(10,2)
  locationRestrict Boolean  @default(false)

  branchId Int?
  branch   Branch? @relation("UserBranch", fields: [branchId], references: [id])

  vouchers                Voucher[]
  categories              Category[]
  products                Product[]
  userCompanyRelationship UserCompanyRelationship[]
  saleUserReports   SaleReport[]   @relation("saleuserfromsalereport")
  saleUserTransfers Transfer[]    @relation("saleuserfromtransfer")
  generalExpenses GeneralExpense[] @relation("userFromGeneralExpense")
  refunds Refund[]
  inventories    InventoryManagement[]
  repay   Repay[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dateOfBirth DateTime?

  @@index([branchId])
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id        Int     @id @default(autoincrement())
  title     String
  isDeleted Boolean @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  products Product[]

  @@index([userId])
}

//////////////////////////////////////////////////////
// PRODUCT
//////////////////////////////////////////////////////

model Product {
  id Int @id @default(autoincrement())

  name        String
  code        String  @unique
  barcode     String?
  description String?
  photoUrl    String?

  price     Decimal  @db.Decimal(12, 2)
  costPrice Decimal? @db.Decimal(12, 2)

  stock    Int  @default(0)
  minStock Int?

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  refundItems RefundItem[]
  inventoryItems  InventoryItem[]

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([categoryId])
  @@index([name])
}

//////////////////////////////////////////////////////
// VOUCHER
//////////////////////////////////////////////////////

model Voucher {
  id          Int    @id @default(autoincrement())
  voucherCode String @unique

  type VoucherType @default(DRAFT)

  subTotal    Decimal @default(0.00) @db.Decimal(12, 2)
  tax         Decimal @default(0.00) @db.Decimal(12, 2)
  deliveryFee Decimal @default(0.00) @db.Decimal(12, 2)

  totalPaymentAmount     Decimal @default(0.00) @db.Decimal(12, 2)
  remainingPaymentAmount Decimal @default(0.00) @db.Decimal(12, 2)

  total         Decimal @default(0.00) @db.Decimal(12, 2)
  debt          Decimal @default(0.00) @db.Decimal(12, 2)
  existDebt     Boolean @default(false)

  note          String?
  isDeleted     Boolean @default(false)
  refunds       Refund[]
  isRefund      Boolean @default(false)
  repays        Repay[]

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId Int?
  branch   Branch? @relation("VoucherBranch", fields: [branchId], references: [id])

  items         VoucherItem[]
  payments      Payment[]
  paymentPhotos PaymentPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// VOUCHER ITEM
//////////////////////////////////////////////////////

model VoucherItem {
  id Int @id @default(autoincrement())

  voucherId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  itemId   Int
  name     String
  photoUrl String?

  quantity Int     @default(0)
  price    Decimal @default(0.00) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([voucherId])
}

model Repay {
  id Int @id @default(autoincrement())

  voucherId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])

  paymentDataId Int
  paymentData PaymentData @relation(fields: [paymentDataId], references: [id])

  photoUrl  String?

  amount    Decimal @default(0.00) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([voucherId])
}

//////////////////////////////////////////////////////
// REFUND
//////////////////////////////////////////////////////

model Refund {
  id          Int         @id @default(autoincrement())
  voucherId   Int?
  voucher     Voucher?     @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  amount      Decimal     @db.Decimal(12, 2)
  reason      String?

  paymentType PaymentType @default(CASH)
  refundType  RefundType  @default(FULL)
  paymentDataId Int
  paymentData  PaymentData @relation(fields: [paymentDataId], references: [id])

  userId      Int
  user        User        @relation(fields: [userId], references: [id])

  companyId   Int
  company     Company     @relation(fields: [companyId], references: [id])

  branchId    Int?
  branch      Branch?     @relation(fields: [branchId], references: [id])

  refundItems RefundItem[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isDeleted   Boolean     @default(false)

  @@index([voucherId])
  @@index([companyId])
  @@index([branchId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// REFUND ITEM
//////////////////////////////////////////////////////

model RefundItem {
  id        Int      @id @default(autoincrement())
  refundId  Int
  refund    Refund   @relation(fields: [refundId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity  Int      @default(0)
  price     Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([refundId])
  @@index([productId])
}

model InventoryManagement {
  id        Int               @id @default(autoincrement())
  type      InventoryType

  reason    String?
  note      String?

  totalAmount Decimal     @db.Decimal(12, 2)

  userId    Int
  user      User          @relation(fields: [userId], references: [id])

  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])

  branchId  Int?
  branch    Branch?       @relation(fields: [branchId], references: [id])

  //for request item, if confirmed then add item quantity 
  confirmed Boolean       @default(false)

  items     InventoryItem[]

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  isDeleted Boolean           @default(false)

  @@index([companyId])
  @@index([branchId])
  @@index([userId])
  @@index([type])
}

model InventoryItem {
  id          Int        @id @default(autoincrement())

  inventoryId      Int
  inventory        InventoryManagement @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  productId   Int
  product     Product  @relation(fields: [productId], references: [id])

  photoUrl    String?   

  quantity    Int
  price   Decimal    @db.Decimal(12, 2) @default(0)
  totalAmount Decimal    @db.Decimal(12, 2)

  createdAt   DateTime   @default(now())

  @@index([inventoryId])
  @@index([productId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {
  id Int @id @default(autoincrement())

  voucherId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  paymentDataId Int
  paymentData   PaymentData @relation(fields: [paymentDataId], references: [id])

  amount Decimal     @db.Decimal(12, 2)
  type   PaymentType @default(CASH)

  createdAt DateTime @default(now())

  @@index([voucherId])
}

//////////////////////////////////////////////////////
// PAYMENT PHOTO
//////////////////////////////////////////////////////

model PaymentPhoto {
  id Int @id @default(autoincrement())

  voucherId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  photoUrl String

  createdAt DateTime @default(now())

  @@index([voucherId])
}

//////////////////////////////////////////////////////
// PAYMENT DATA (Accounts)
//////////////////////////////////////////////////////

model PaymentData {
  id Int @id @default(autoincrement())
  accountNumber String?
  accountName   String
  accountType   AccountType
  balance       Decimal @db.Decimal(12, 2) @default(0)
  companyId Int
  userId    Int

  isActive Boolean @default(true)

  payments Payment[]
  fromAccount Transfer[] @relation("fromAccount")
  toAccount   Transfer[]  @relation("toAccount")

  refunds   Refund[]
  repays    Repay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

//////////////////////////////////////////////////////
// CURRENCY
//////////////////////////////////////////////////////

model Currency {
  id             Int     @id @default(autoincrement())
  currencyCode   String  @unique
  value          Int     @default(1)
  setDefault     Boolean @default(false)
  currencySymbol String

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

//////////////////////////////////////////////////////
// USER COMPANY RELATION
//////////////////////////////////////////////////////

model UserCompanyRelationship {
  id Int @id @default(autoincrement())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
}
