// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  role      Role     @default(CUSTOMER)

  firstName String?
  lastName  String?
  password  String?
  phone     String?
  photoUrl  String?

  gender    Gender   @default(MALE)
  isDeleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories Category[]    @relation("categories")
  products   Product[]     @relation("product")
  userCompanyRelationship UserCompanyRelationship[]
}

model Company {
  id      Int    @id @default(autoincrement())
  code    String?
  email   String @unique
  name    String @unique
  phone   String?
  address String?

  products Product[]      @relation("productByCompany")
  userCompanyRelationship UserCompanyRelationship[]
}

model Category {
  id        Int      @id @default(autoincrement())
  title     String
  isDeleted Boolean  @default(false)

  userId    Int
  user      User     @relation("categories", fields: [userId], references: [id], onDelete: Cascade)

  products  Product[] @relation("productByCategories")
}

model Product {
  id          Int      @id @default(autoincrement())

  name        String
  code        String   @unique
  barcode     String? 
  description String?

  price       Decimal  @db.Decimal(10,2)
  costPrice   Decimal? @db.Decimal(10,2)

  stock       Int      @default(0)
  minStock    Int?

  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)

  categoryId  Int
  category    Category @relation("productByCategories",fields: [categoryId], references: [id])

  userId      Int
  user        User     @relation("product",fields: [userId], references: [id])

  companyId   Int
  company     Company  @relation("productByCompany", fields: [companyId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model DeviceInfo {
  id          Int      @id @default(autoincrement())
  deviceToken String   @unique
  deviceType  String?
  deviceName  String?
  ipAddress   String?
  lastActive  DateTime @default(now())
}

model UserCompanyRelationship {
  id                      Int                   @id @default(autoincrement())
  companyId               Int 
  company                 Company               @relation(fields:[companyId], references: [id])
  userId                  Int 
  user                    User                  @relation(fields:[userId], references: [id])
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  CUSTOMER
  POS
  ADMIN
  SUPERADMIN
}