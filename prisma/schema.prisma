generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum Gender {
  MALE
  FEMALE
}

enum CompanyType {
  SHOP
  RESTAURANT
}

enum HrRuleType {
  DEDUCT
  OVERTIME
  EARLY_LEAVE
  LEAVE_ALLOW
}

enum VoucherType {
  SAVE
  DRAFT
}

enum PaymentType {
  CASH
  BANK
  CARD
  EWALLET
}

enum AccountType {
  CASH
  BANK
  CARD
  EWALLET
}

enum RefundType {
  FULL
  PARTIAL
}

enum InventoryType {
  EXPIRED
  DAMAGED
  REQUESTED
}

enum Role {
  CUSTOMER
  SALE
  POS
  ADMIN
  MANAGER
  WAITER
  SUPERADMIN
}

enum EmployeeType {
  MONTHLY
  HOURLY
}

enum TransactionType {
  OPENING_BALANCE
  CLOSING_BALANCE
}

model SaleReport {
  id            Int    @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  date          DateTime
  type          TransactionType // e.g., 'OPENING_BALANCE', 'SALE', 'REFUND', 'CLOSING_BALANCE', 'EXPENSE'
  amount        Decimal     @db.Decimal(12, 2) // The value of the transaction
  description   String?   // Optional: details like product name, reason for expense
  saleId        Int
  saleUser      User     @relation("saleuserfromsalereport", fields: [saleId], references: [id])
  isClosed      Boolean   @default(false)          

  companyId     Int
  company       Company     @relation("companyfromsalereport", fields: [companyId], references: [id])

  branchId      Int?
  branch        Branch?     @relation("branchfromsalereport", fields: [branchId], references: [id])

  isDeleted     Boolean     @default(false)
}

model Transfer {
  id            Int    @id @default(autoincrement())
  createdAt     DateTime  @default(now())
  date          DateTime
  amount        Decimal     @db.Decimal(12, 2) 

  from          Int
  fromAccount   PaymentData @relation("fromAccount",fields: [from], references: [id])

  to            Int
  toAccount     PaymentData @relation("toAccount", fields: [to], references: [id])

  saleId        Int
  saleUser      User     @relation("saleuserfromtransfer", fields: [saleId], references: [id])

  companyId     Int
  company       Company     @relation("companyfromtransfer", fields: [companyId], references: [id])

  branchId      Int?
  branch        Branch?     @relation("branchfromtransfer", fields: [branchId], references: [id])


  isDeleted     Boolean     @default(false)
}

model GeneralExpense {
  id        Int      @id @default(autoincrement())

  title     String
  reason    String?
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime

  // 🔗 Company Relation
  company   Company  @relation("companyFromGeneralExpense", fields: [companyId], references: [id])
  companyId Int

  // 🔗 Branch Relation (Optional)
  branch    Branch?  @relation("branchFromGeneralExpense", fields: [branchId], references: [id])
  branchId  Int?

  // 🔗 User Relation
  user      User     @relation("userFromGeneralExpense", fields: [userId], references: [id])
  userId    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([companyId])
  @@index([branchId])
  @@index([userId])
  @@index([date])
}

//////////////////////////////////////////////////////
// COMPANY
//////////////////////////////////////////////////////

model Company {
  id       Int     @id @default(autoincrement())
  country  String  @default("MM")
  code     String?
  email    String  @unique
  name     String  @unique
  phone    String?
  address  String?
  photoUrl String?
  lat      String?
  long     String?
  type     CompanyType    @default(SHOP)
  isTrial   Boolean       @default(true)
  payroll   Payroll[]

  products           Product[]
  leaves              Leave[]
  vouchers           Voucher[]
  branches           Branch[]
  currencies         Currency[]
  users              User[]
  saleReports        SaleReport[] @relation("companyfromsalereport")
  transfers          Transfer[]   @relation("companyfromtransfer")
  generalExpenses    GeneralExpense[] @relation("companyFromGeneralExpense")
  refunds            Refund[]
  Attendances        Attendance[]
  inventories        InventoryManagement[]
  subscriptionPayments  SubscriptionPayment[]
  subscriptions      Subscription[]
  repay              Repay[]
  hrRules            HrRule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
}

//////////////////////////////////////////////////////
// BRANCH
//////////////////////////////////////////////////////

model Branch {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String
  address   String?
  latitude  String?
  longitude String?
  isDeleted Boolean @default(false)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  saleReports        SaleReport[] @relation("branchfromsalereport")
  transfers          Transfer[]   @relation("branchfromtransfer")
  payroll   Payroll[]
  leaves              Leave[]
  generalExpenses GeneralExpense[] @relation("branchFromGeneralExpense")
  refunds         Refund[]
  inventories     InventoryManagement[]
  Attendances             Attendance[]
  hrRules HrRule[]
  repay   Repay[]

  users    User[]    @relation("UserBranch")
  vouchers Voucher[] @relation("VoucherBranch")

  @@index([companyId])
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  role  Role   @default(CUSTOMER)
  employeeType EmployeeType? @default(MONTHLY)

  firstName String?
  lastName  String?
  password  String?
  phone     String?
  photoUrl  String?
  address   String?

  gender    Gender  @default(MALE)
  isDeleted Boolean @default(false)

  monthlySalary    Int?
  hourlySalary Decimal? @db.Decimal(10,2)
  locationRestrict Boolean  @default(false)
  holidays  String[]
  startTime String?
  endTime  String?
  lunchTime String?

  branchId Int?
  branch   Branch? @relation("UserBranch", fields: [branchId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  payrolls        Payroll[] @relation("PayrollUser")
  approvedPayrolls Payroll[] @relation("PayrollApproveUser")
  leaves     Leave[]    @relation("leaveUser")
  approvedLeaves  Leave[] @relation("approvedUser")
  subscriptions           Subscription[]
  vouchers                Voucher[]
  categories              Category[]
  products                Product[]
  Attendances             Attendance[]
  subscriptionPayments  SubscriptionPayment[]
  saleUserReports   SaleReport[]   @relation("saleuserfromsalereport")
  saleUserTransfers Transfer[]    @relation("saleuserfromtransfer")
  generalExpenses GeneralExpense[] @relation("userFromGeneralExpense")
  refunds Refund[]
  inventories    InventoryManagement[]
  repay   Repay[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dateOfBirth DateTime?

  @@index([branchId])
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id        Int     @id @default(autoincrement())
  title     String
  isDeleted Boolean @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  products Product[]

  @@index([userId])
}

//////////////////////////////////////////////////////
// PRODUCT
//////////////////////////////////////////////////////

model Product {
  id Int @id @default(autoincrement())

  name        String
  code        String  @unique
  barcode     String?
  description String?
  photoUrl    String?

  price     Decimal  @db.Decimal(12, 2)
  costPrice Decimal? @db.Decimal(12, 2)

  stock    Int  @default(0)
  minStock Int?

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  refundItems RefundItem[]
  inventoryItems  InventoryItem[]

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([categoryId])
  @@index([name])
}

//////////////////////////////////////////////////////
// VOUCHER
//////////////////////////////////////////////////////

model Voucher {
  id          Int    @id @default(autoincrement())
  voucherCode String @unique

  type VoucherType @default(DRAFT)

  subTotal    Decimal @default(0.00) @db.Decimal(12, 2)
  tax         Decimal @default(0.00) @db.Decimal(12, 2)
  deliveryFee Decimal @default(0.00) @db.Decimal(12, 2)

  totalPaymentAmount     Decimal @default(0.00) @db.Decimal(12, 2)
  remainingPaymentAmount Decimal @default(0.00) @db.Decimal(12, 2)

  total         Decimal @default(0.00) @db.Decimal(12, 2)
  debt          Decimal @default(0.00) @db.Decimal(12, 2)
  existDebt     Boolean @default(false)

  note          String?
  isDeleted     Boolean @default(false)
  refunds       Refund[]
  isRefund      Boolean @default(false)
  repays        Repay[]

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId Int?
  branch   Branch? @relation("VoucherBranch", fields: [branchId], references: [id])

  items         VoucherItem[]
  payments      Payment[]
  paymentPhotos PaymentPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

//////////////////////////////////////////////////////
// VOUCHER ITEM
//////////////////////////////////////////////////////

model VoucherItem {
  id Int @id @default(autoincrement())

  voucherId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  itemId   Int
  name     String
  photoUrl String?

  quantity     Int     @default(0)
  price        Decimal @default(0.00) @db.Decimal(12, 2)
  costPrice    Decimal @default(0.00) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([voucherId])
}

model Repay {
  id Int @id @default(autoincrement())

  voucherId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])

  paymentDataId Int
  paymentData PaymentData @relation(fields: [paymentDataId], references: [id])

  photoUrl  String?

  amount    Decimal @default(0.00) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([voucherId])
}

//////////////////////////////////////////////////////
// REFUND
//////////////////////////////////////////////////////

model Refund {
  id          Int         @id @default(autoincrement())
  voucherId   Int?
  voucher     Voucher?     @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  amount      Decimal     @db.Decimal(12, 2)
  reason      String?

  paymentType PaymentType @default(CASH)
  refundType  RefundType  @default(FULL)
  paymentDataId Int
  paymentData  PaymentData @relation(fields: [paymentDataId], references: [id])

  userId      Int
  user        User        @relation(fields: [userId], references: [id])

  companyId   Int
  company     Company     @relation(fields: [companyId], references: [id])

  branchId    Int?
  branch      Branch?     @relation(fields: [branchId], references: [id])

  refundItems RefundItem[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isDeleted   Boolean     @default(false)

  @@index([voucherId])
  @@index([companyId])
  @@index([branchId])
  @@index([userId])
}

//////////////////////////////////////////////////////
// REFUND ITEM
//////////////////////////////////////////////////////

model RefundItem {
  id        Int      @id @default(autoincrement())
  refundId  Int
  refund    Refund   @relation(fields: [refundId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity  Int      @default(0)
  price     Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([refundId])
  @@index([productId])
}

model InventoryManagement {
  id        Int               @id @default(autoincrement())
  type      InventoryType

  reason    String?
  note      String?

  totalAmount Decimal     @db.Decimal(12, 2)

  userId    Int
  user      User          @relation(fields: [userId], references: [id])

  companyId Int
  company   Company       @relation(fields: [companyId], references: [id])

  branchId  Int?
  branch    Branch?       @relation(fields: [branchId], references: [id])

  //for request item, if confirmed then add item quantity 
  confirmed Boolean       @default(false)

  items     InventoryItem[]

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  isDeleted Boolean           @default(false)

  @@index([companyId])
  @@index([branchId])
  @@index([userId])
  @@index([type])
}

model InventoryItem {
  id          Int        @id @default(autoincrement())

  inventoryId      Int
  inventory        InventoryManagement @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  productId   Int
  product     Product  @relation(fields: [productId], references: [id])

  photoUrl    String?   

  quantity    Int
  price   Decimal    @db.Decimal(12, 2) @default(0)
  totalAmount Decimal    @db.Decimal(12, 2)

  createdAt   DateTime   @default(now())

  @@index([inventoryId])
  @@index([productId])
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {
  id Int @id @default(autoincrement())

  voucherId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  paymentDataId Int
  paymentData   PaymentData @relation(fields: [paymentDataId], references: [id])

  amount Decimal     @db.Decimal(12, 2)
  type   PaymentType @default(CASH)

  createdAt DateTime @default(now())

  @@index([voucherId])
}

//////////////////////////////////////////////////////
// PAYMENT PHOTO
//////////////////////////////////////////////////////

model PaymentPhoto {
  id Int @id @default(autoincrement())

  voucherId Int
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  photoUrl String

  createdAt DateTime @default(now())

  @@index([voucherId])
}

//////////////////////////////////////////////////////
// PAYMENT DATA (Accounts)
//////////////////////////////////////////////////////

model PaymentData {
  id Int @id @default(autoincrement())
  accountNumber String?
  accountName   String
  accountType   AccountType
  balance       Decimal @db.Decimal(12, 2) @default(0)
  companyId Int
  userId    Int

  isActive Boolean @default(true)

  payments Payment[]
  fromAccount Transfer[] @relation("fromAccount")
  toAccount   Transfer[]  @relation("toAccount")

  refunds   Refund[]
  repays    Repay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

//////////////////////////////////////////////////////
// CURRENCY
//////////////////////////////////////////////////////

model Currency {
  id             Int     @id @default(autoincrement())
  currencyCode   String  @unique
  value          Int     @default(1)
  setDefault     Boolean @default(false)
  currencySymbol String

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

enum OvertimeType {
  NONE
  MINUTES
  DAY
}

model Attendance {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])

  date DateTime

  // ✅ DateTime instead of String
  checkIn   String?
  checkOut  String?

  isLate            Boolean @default(false)
  isEarlyLeave      Boolean @default(false)
  lateMinutes       Int      @default(0)
  overtimeMinutes   Int   @default(0)
  earlyLeaveMinutes Int   @default(0)
  workingMinutes    Int     @default(0)

  // ✅ Overtime must be approved before payroll picks it up
  overtimeApproved  Boolean @default(false)
  overtimeType      OvertimeType @default(NONE)

  status AttendanceStatus @default(PRESENT)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([userId])
  @@index([companyId])
  @@index([date])
}
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Leave {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation("leaveUser",fields: [userId], references: [id])

  approvedId  Int?
  approveUser User? @relation("approvedUser",fields: [approvedId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  branchId Int?
  branch   Branch? @relation(fields: [branchId], references: [id])

  date DateTime

  title String
  status LeaveStatus

  imageUrl String?


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([userId])
  @@index([approvedId])
  @@index([companyId])
  @@index([date])
}

model HrRule {
  id           Int       @id @default(autoincrement())
  
  // Relation to Company
  companyId    Int
  company      Company   @relation(fields: [companyId], references: [id])
  
  branchId     Int?      // Optional: branch-specific rules
  branch       Branch?   @relation(fields: [branchId], references: [id])

  type         HrRuleType @default(DEDUCT)

  thresholdMinute Int?
  thresholdAmount Int?
  thresholdAmountPercent Int?
  thresholdDays   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

model Payroll {
  id          Int           @id @default(autoincrement())

  userId      Int
  user        User          @relation("PayrollUser",fields: [userId], references: [id])

  approveUserId      Int
  approveUser        User          @relation("PayrollApproveUser", fields: [approveUserId], references: [id])

  companyId   Int
  company     Company       @relation(fields: [companyId], references: [id])

  branchId    Int?
  branch      Branch?       @relation(fields: [branchId], references: [id])

  month       Int           // 1–12
  year        Int

  // Salary breakdown
  baseSalary        Decimal @db.Decimal(12, 2)
  lateDeduction     Decimal @db.Decimal(12, 2) @default(0)
  earlyLeaveDeduction Decimal @db.Decimal(12, 2) @default(0)
  overtime          Decimal @db.Decimal(12, 2) @default(0)
  bonus             Decimal @db.Decimal(12, 2) @default(0)
  deduction         Decimal @db.Decimal(12, 2) @default(0)
  leaveDeduction    Decimal @db.Decimal(12, 2) @default(0)
  netSalary         Decimal @db.Decimal(12, 2)
  totalDeductions   Decimal @db.Decimal(12, 2)
  // Summary counts
  totalWorkingDays  Int     @default(0)
  presentDays       Int     @default(0)
  absentDays        Int     @default(0)
  halfDays          Int     @default(0)
  leaveDays         Decimal @db.Decimal(4, 1) @default(0)
  lateTotalMinutes  Int     @default(0)
  earlyLeaveTotalMinutes  Int     @default(0)
  overtimeTotalMinutes Int  @default(0)
  overtimeDays      Int     @default(0)

  status      PayrollStatus @default(DRAFT)
  note        String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, month, year])  // one payroll per employee per month
  @@index([companyId])
  @@index([branchId])
  @@index([month, year])
}

model Plan {
  id        Int      @id @default(autoincrement())

  name      String   // "MONTHLY", "6_MONTHS", "YEARLY"
  title     String   // UI display name

  durationDays Int   // 30, 180, 365
  month      Int    @default(1)

  priceMMK  Decimal  @db.Decimal(12, 2)
  priceUSD  Decimal  @db.Decimal(12, 2)

  discountPercent Int @default(0)

  isPopular Boolean @default(false)

  isActive Boolean @default(true)

  existBranch   Boolean   @default(false)

  subscriptions Subscription[]

  planFeatures  PlanFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

model Subscription {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  planId Int
  plan   Plan @relation(fields: [planId], references: [id])

  startDate DateTime @default(now())
  endDate   DateTime

  isActive Boolean @default(true)

  status SubscriptionStatus @default(ACTIVE)

  subscriptionPayments  SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@index([userId])
  @@index([companyId])
}

enum SubscriptionPaymentType {
  CARD 
  EWALLET
}

model SubscriptionPayment {
  id        Int      @id @default(autoincrement())
  amount    Int      @default(0)

  userId      Int
  user        User          @relation(fields: [userId], references: [id])

  companyId   Int
  company     Company       @relation(fields: [companyId], references: [id])

  imageUrl    String? 

  type        SubscriptionPaymentType @default(EWALLET)

  subscriptionId  Int         
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PlanFeature {
  id        Int    @id @default(autoincrement())

  planId    Int
  plan      Plan   @relation(fields: [planId], references: [id])

  icon      String
  key       String // "AI_REQUEST_LIMIT", "ALL_FEATURE_ACCESS"
  value     String // "10", "true"

  createdAt DateTime @default(now())
}

model SuperAdminPhoneNumber {
  id        Int    @id @default(autoincrement())

  phoneNumber String  
  name        String  @default("Oakar Kyaw")

  createdAt DateTime @default(now())
}